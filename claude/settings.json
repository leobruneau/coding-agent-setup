{
  "env": {
    "CLAUDE_CODE_PLUGIN_DIRS": "{{HOME}}/.claude/mods/context-bar"
  },
  "permissions": {
    "deny": [
      "EnterPlanMode",
      "ExitPlanMode",
      "DesignSync",
      "NotebookEdit",
      "SendMessage",
      "PushNotification",
      "RemoteTrigger",
      "ReportFindings",
      "ScheduleWakeup",
      "AskUserQuestion",
      "CronCreate",
      "CronDelete",
      "CronList"
    ],
    "defaultMode": "auto"
  },
  "model": "opus",
  "disableClaudeAiConnectors": true,
  "skillOverrides": {
    "handoff": "user-invocable-only",
    "time-machine": "user-invocable-only",
    "graphify": "user-invocable-only",
    "plugin-authoring": "user-invocable-only",
    "morning": "user-invocable-only",
    "deep-research": "user-invocable-only",
    "xlsx": "user-invocable-only",
    "pdf": "user-invocable-only",
    "import-memory": "user-invocable-only",
    "docs": "user-invocable-only",
    "skill-creator": "user-invocable-only",
    "pptx": "user-invocable-only",
    "google-workspace": "user-invocable-only",
    "chrome-browser": "user-invocable-only",
    "built-in-browser": "user-invocable-only",
    "computer-use": "user-invocable-only",
    "docx": "user-invocable-only",
    "web-artifacts-builder": "user-invocable-only"
  },
  "disableBundledSkills": true,
  "disableRemoteControl": true,
  "disableWorkflows": true,
  "disableArtifact": true,
  "enabledPlugins": {
    "frontend-design@claude-plugins-official": false,
    "skill-creator@claude-plugins-official": false,
    "claude-md-management@claude-plugins-official": false,
    "feature-dev@claude-plugins-official": false,
    "remember@claude-plugins-official": false,
    "mattpocock-skills@claude-plugins-official": true,
    "egm@egm": true,
    "unattended-run@leobruneau-skills": true
  },
  "extraKnownMarketplaces": {
    "egm": {
      "source": {
        "source": "github",
        "repo": "google/elephant-goldfish-model"
      }
    },
    "leobruneau-skills": {
      "source": {
        "source": "github",
        "repo": "leobruneau/coding-agent-setup"
      }
    }
  },
  "effortLevel": "medium",
  "modelSettings": {
    "claude-opus-5-5": {
      "effortLevel": "medium"
    }
  },
  "tui": "fullscreen",
  "autoMemoryEnabled": false
}
