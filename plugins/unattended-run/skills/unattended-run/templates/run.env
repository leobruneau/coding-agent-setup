# Settings for the run's scripts in tools/. Root fills this in at setup; nobody edits it after launch.
RUN_NAME="<short name, e.g. zero-shot search 2026-11-01>"
TAG="<2 or 3 words naming the task, e.g. mirror-zeroshot>"  # session names: "$TAG | O<N>", "$TAG | FS"
RUN_DIR="<absolute path of unattended-run-YYYY-MM-DD-HHMM-TAG>"
WORKSPACE="<absolute path where code and commands run>"
PREFIX="<name prefix for the run's background jobs and processes>"
ORCH_MODEL=opus
PERMISSION_MODE=auto        # agreed with the user at setup
MAX_ORCH=10                 # backstop: the run stops instead of launching orchestrator MAX_ORCH+1
STOP_AT=""                  # "YYYY-MM-DD HH:MM" when background work stops, or empty
SUMMARY_AT=""               # STOP_AT plus 15 minutes, or empty
WATCHDOG_MIN=45             # minutes of LOG.md silence before the watchdog launches a new orchestrator
CANCEL_CMD=""               # command that cancels the run's scheduler or CI jobs by name, or empty
